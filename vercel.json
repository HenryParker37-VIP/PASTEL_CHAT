{
  "version": 2,
  "buildCommand": "cd frontend && npm install && CI=false npm run build",
  "outputDirectory": "frontend/build",
  "functions": {
    "api/index.js": {
      "includeFiles": "backend/src/db/seedData.json",
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/auth/(.*)", "destination": "/api/index.js" },
    { "source": "/users", "destination": "/api/index.js" },
    { "source": "/users/(.*)", "destination": "/api/index.js" },
    { "source": "/friends", "destination": "/api/index.js" },
    { "source": "/friends/(.*)", "destination": "/api/index.js" },
    { "source": "/messages", "destination": "/api/index.js" },
    { "source": "/messages/(.*)", "destination": "/api/index.js" },
    { "source": "/groups", "destination": "/api/index.js" },
    { "source": "/groups/(.*)", "destination": "/api/index.js" },
    { "source": "/private-space", "destination": "/api/index.js" },
    { "source": "/private-space/(.*)", "destination": "/api/index.js" },
    { "source": "/feedback", "destination": "/api/index.js" },
    { "source": "/feedback/(.*)", "destination": "/api/index.js" },
    { "source": "/admin/(.*)", "destination": "/api/index.js" },
    { "source": "/push", "destination": "/api/index.js" },
    { "source": "/push/(.*)", "destination": "/api/index.js" },
    { "source": "/notifications", "destination": "/api/index.js" },
    { "source": "/notifications/(.*)", "destination": "/api/index.js" },
    { "source": "/releases", "destination": "/api/index.js" },
    { "source": "/releases/(.*)", "destination": "/api/index.js" },
    { "source": "/stickers", "destination": "/api/index.js" },
    { "source": "/stickers/(.*)", "destination": "/api/index.js" },
    { "source": "/ai", "destination": "/api/index.js" },
    { "source": "/ai/(.*)", "destination": "/api/index.js" },
    { "source": "/health", "destination": "/api/index.js" },
    { "source": "/telegram/(.*)", "destination": "/api/index.js" },
    { "source": "/((?!api/|auth/|users|friends|messages|groups|private-space|feedback|admin/|push|notifications|releases|stickers|ai|health|telegram/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(self), geolocation=(), payment=()" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://accounts.google.com https://apis.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; media-src 'self' data: blob:; connect-src 'self' https://accounts.google.com https://apis.google.com https://pastel-chat.vercel.app https://*.vercel.app wss://*.onrender.com https://*.onrender.com https://api.giphy.com; frame-src 'self' https://accounts.google.com; frame-ancestors 'none';"
        }
      ]
    },
    {
      "source": "/static/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
