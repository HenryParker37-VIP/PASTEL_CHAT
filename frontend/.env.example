REACT_APP_GOOGLE_CLIENT_ID=803433790062-2dmhg2du471q65q2biheuli604b31vgv.apps.googleusercontent.com
REACT_APP_MICROSOFT_CLIENT_ID=your-microsoft-client-id
REACT_APP_BACKEND_URL=https://pastel-chat.vercel.app
REACT_APP_SIGNALING_URL=
# Optional read-only Socket.IO relay. Leave unset until the hybrid frontend is reviewed.
# REST stays on REACT_APP_BACKEND_URL (Vercel); Render may sleep without affecting sends.
REACT_APP_REALTIME_RELAY_URL=

# VAPID public key for Web Push (must match VAPID_PUBLIC_KEY in backend .env)
REACT_APP_VAPID_PUBLIC_KEY=your-vapid-public-key
