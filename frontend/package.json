{
  "name": "pastel-chat-frontend",
  "version": "1.1.0",
  "private": true,
  "dependencies": {
    "@azure/msal-browser": "^5.10.1",
    "@capacitor/app": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/filesystem": "^6.0.0",
    "@capacitor/ios": "^6.2.1",
    "@capacitor/push-notifications": "^6.0.0",
    "@react-oauth/google": "^0.12.1",
    "@react-pdf/renderer": "^4.5.1",
    "axios": "^1.6.2",
    "electron-updater": "^6.8.3",
    "pako": "^2.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.21.0",
    "react-scripts": "5.0.1",
    "socket.io-client": "^4.7.4"
  },
  "homepage": "./",
  "main": "public/electron.js",
  "scripts": {
    "start": "react-scripts start",
    "build": "node scripts/generate-build-meta.js && GENERATE_SOURCEMAP=false react-scripts build",
    "lint": "eslint src/App.js src/pages/Resume.js src/components/ResumePdfDocument.js src/data/resumeData.js",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "cap:add:ios": "npx cap add ios",
    "cap:build:ios": "npm run build && npx cap copy && npx cap open ios",
    "cap:sync:ios": "npm run build && npx cap sync ios",
    "cap:open:ios": "npx cap open ios",
    "electron": "electron .",
    "electron-dev": "concurrently \"BROWSER=none REACT_APP_BACKEND_URL=https://pastel-chat.vercel.app REACT_APP_IS_ELECTRON=true npm start\" \"wait-on http://localhost:3000 && electron .\"",
    "electron-build": "cp .env.electron .env.local && npm run build && electron-builder --config electron-builder.json && rm -f .env.local",
    "electron-build:win": "cp .env.electron .env.local && npm run build && electron-builder --win --config electron-builder.json && rm -f .env.local"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "proxy": "http://localhost:5002",
  "devDependencies": {
    "@capacitor/cli": "^6.0.0",
    "concurrently": "^9.2.1",
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1",
    "sharp": "^0.34.5",
    "wait-on": "^9.0.10"
  }
}
